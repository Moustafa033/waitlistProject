# Hostinger (LiteSpeed / Apache) configuration. Upload the CONTENTS of site/ into public_html/.
# Configured for creatinginpublic.com and Supabase project opynnvrkbrmtfrneefxm.
# Turn on hPanel -> Security -> SSL -> "Force HTTPS" as well.
#
# No <IfModule> wrappers on purpose: if headers or rewrites are not supported, the server
# returns an error (fail closed) instead of silently serving the page WITHOUT protection.
# The CSP below must stay identical to site/_headers (ci/check-site.sh compares them).

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# 1) Exactly ONE origin. The backend accepts requests only from SITE_ORIGIN, so
#    www.creatinginpublic.com (or the Hostinger preview address) is sent to the real address.
RewriteCond %{HTTP_HOST} !^creatinginpublic[.]com$ [NC]
RewriteRule ^ https://creatinginpublic.com%{REQUEST_URI} [R=301,L]

# 2) Never serve hidden files (.htaccess, .git, .env, ...) except /.well-known/, nor our config notes.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^_headers$ - [F,L]

# 3) Clean URLs: /confirm -> confirm.html, /unsubscribe -> unsubscribe.html, /privacy -> privacy.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

# 4) Security headers (same as site/_headers)
Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://opynnvrkbrmtfrneefxm.supabase.co; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always unset X-Powered-By

# HTML, JS and CSS: the browser must re-check with the server every time (cheap: ETag, 304).
# Otherwise an update (new consent version, new code) reaches visitors only days later, and a
# stale page sends an old consent version that the server must refuse ("reload_page").
<FilesMatch "\.(html|js|css)$">
  Header unset Cache-Control
  Header unset Expires
  Header always set Cache-Control "no-cache"
</FilesMatch>

# Pages that receive tokens in the #fragment: never cached at all
<FilesMatch "^(confirm|unsubscribe)\.html$">
  Header always set Cache-Control "no-store"
</FilesMatch>
