# Hostinger (LiteSpeed / Apache) configuration. Upload the CONTENTS of site/ into public_html/.
# Replace YOUR-DOMAIN (e.g. example.com, no https://) and YOUR-PROJECT-REF before uploading.
# Turn on hPanel -> Security -> SSL -> "Force HTTPS" as well.
#
# No <IfModule> wrappers on purpose: if headers or rewrites are not supported, the server
# returns an error (fail closed) instead of silently serving the page WITHOUT protection.
# The CSP below must stay identical to site/_headers (ci/check-site.sh compares them).

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# 1) Exactly ONE origin. The backend accepts requests only from SITE_ORIGIN, so
#    www.YOUR-DOMAIN (or the Hostinger preview address) is sent to the real address.
RewriteCond %{HTTP_HOST} !^YOUR-DOMAIN$ [NC]
RewriteRule ^ https://YOUR-DOMAIN%{REQUEST_URI} [R=301,L]

# 2) Never serve hidden files (.htaccess, .git, .env, ...) except /.well-known/, nor our config notes.
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^_headers$ - [F,L]

# 3) Clean URLs: /confirm -> confirm.html, /unsubscribe -> unsubscribe.html, /privacy -> privacy.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]

# 4) Security headers (same as site/_headers)
Header always set Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://YOUR-PROJECT-REF.supabase.co; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
Header always set Cross-Origin-Resource-Policy "same-origin"
Header always unset X-Powered-By

# Pages that receive tokens in the #fragment: never cached
<FilesMatch "^(confirm|unsubscribe)\.html$">
  Header always set Cache-Control "no-store"
</FilesMatch>
