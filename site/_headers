# Cloudflare Pages security headers. Replace YOUR-PROJECT-REF.
# Strict CSP: only our own files + Turnstile. No inline script/style, no eval,
# no third-party analytics. Test with https://csp-evaluator.withgoogle.com
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src https://YOUR-PROJECT-REF.supabase.co; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/confirm
  Cache-Control: no-store
/unsubscribe
  Cache-Control: no-store
